{
  "manifest_version": 3,
  "name": "Offwork Countdown — 下班倒计时",
  "short_name": "下班倒计时",
  "version": "1.7.0",
  "description": "Apple 风格的下班倒计时：角标倒计时、下班提醒、节假日调休日历、月薪折算与自定义倒数日；午休不计有效工时，周末前与节前专属仪式感。",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "notifications", "activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core.js", "theme.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["xiangqi.js", "mahjong.js", "minesweeper.js", "g2048.js", "lianliankan.js", "content_pet.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-float-widget": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Alt+W"
      },
      "description": "打开/收起 网页端大圆角毛玻璃悬浮小组件"
    },
    "toggle-pet-widget": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "打开/收起 网页端摸鱼兽聊天悬浮窗"
    }
  },
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "offline_enabled": true
}
